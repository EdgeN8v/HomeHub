.auto-card.off { opacity:.68; } .auto-card-head { display:flex; align-items:center; gap:8px; } .auto-icon { width:35px; height:35px; display:grid; place-items:center; border-radius:13px; background:color-mix(in srgb,#14a38b 14%,transparent); color:#14a38b; } .auto-icon svg{width:22px;height:22px}
.auto-card .sw { margin-left:auto; transform:scale(.82); transform-origin:right center; } .auto-state{font-size:12px;color:var(--sub)} .auto-state.on{color:#14a38b;font-weight:600}.auto-card .an{font-size:17px;line-height:1.25;margin:12px 0 8px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.auto-flow{font-size:12px;line-height:1.5;color:var(--sub);overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}.auto-flow i{font-style:normal;color:#14a38b;margin:0 3px}.auto-flow b{font-weight:500;color:var(--text)}.auto-card .as{font-size:11px;color:var(--sub);margin-top:auto;padding-top:9px}
.ed-section { padding:14px 18px; }.ed-section-head { display:flex; gap:10px; align-items:center; margin:2px 0 6px; }.ed-section-head>span{width:24px;height:24px;display:grid;place-items:center;border-radius:50%;background:color-mix(in srgb,#14a38b 13%,transparent);color:#14a38b;font-size:12px;font-weight:700}.ed-section-head h3{margin:0;font-size:17px}.ed-section-head small{color:var(--sub);font-size:12px}.ed-empty{padding:4px 0;margin:0;text-align:left}
.ed-rule{width:100%;display:flex;align-items:center;gap:11px;text-align:left;padding:11px 0;border-top:1px solid var(--line)}.ed-rule-ico{width:34px;height:34px;display:grid;place-items:center;flex:none;border-radius:12px;color:#14a38b;background:color-mix(in srgb,#14a38b 13%,transparent)}.ed-rule-ico svg{width:20px;height:20px}.ed-rule-main{display:flex;flex-direction:column;min-width:0;flex:1}.ed-rule-main small{color:var(--sub);font-size:11px}.ed-rule-main b{font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ed-time-card{display:flex;align-items:center;gap:11px;padding:14px 18px}.ed-time-open{display:flex;flex-direction:column;align-items:flex-start;flex:1;text-align:left}.ed-time-open small{color:var(--sub);font-size:12px}.ed-time-open b{font-size:16px;font-weight:500;margin-top:2px}
.ed-option{width:100%;display:flex;align-items:center;gap:11px;text-align:left;padding:12px 2px;border-top:1px solid var(--line)}.ed-option:first-child{border-top:0}.ed-option-ico{width:32px;height:32px;display:grid;place-items:center;border-radius:11px;color:#14a38b;background:color-mix(in srgb,#14a38b 13%,transparent)}.ed-option-ico svg{width:19px;height:19px}.ed-option>span:nth-child(2){flex:1}.ed-option>b{color:var(--sub);font-weight:400;font-size:20px}
@media(max-width:360px){.auto-grid{grid-template-columns:1fr}.auto-card{min-height:150px}}

/* Polished time window picker: presets plus a clear editable interval. */
.ed-window-title{display:flex;align-items:center;justify-content:center;gap:8px}.ed-window-title svg{width:23px;height:23px;color:#14a38b}.ed-time-presets{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:16px 0}.ed-time-presets button{padding:10px 4px;border-radius:13px;background:var(--card2);font-weight:600}.ed-time-presets button:active{background:color-mix(in srgb,#14a38b 18%,transparent);color:#14a38b}.ed-win{align-items:stretch;gap:8px;margin:4px 0 18px}.ed-win label{display:flex;flex-direction:column;align-items:flex-start;gap:2px;padding:9px 10px;border-radius:14px;background:var(--card2)}.ed-win label small,.ed-week-label{font-size:12px;color:var(--sub)}.ed-win input{width:100%;font-size:18px;background:transparent;border:0;color:var(--text)}.ed-win>span{align-self:center;color:var(--sub)}.ed-week-label{margin:2px 0 6px}.ed-days{justify-content:space-between;margin-top:0}.ed-days .chip{padding:8px 12px;border-radius:50%}
