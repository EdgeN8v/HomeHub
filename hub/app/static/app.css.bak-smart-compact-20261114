/* Mijia-like look: a dusk gradient behind everything, translucent cards that turn solid white when
   the device is on, white header text over the gradient. Cards deliberately have no backdrop blur:
   over a smooth gradient it looks the same, and blurring dozens of moving cards made swipes stutter.
   Blur stays only on the few fixed / sticky bars. */
:root {
  --sky: linear-gradient(175deg, #7f86b5 0%, #a597b8 26%, #cfa9b1 52%, #e8cfc6 78%, #f1e4dd 100%);
  --glass: rgba(255, 255, 255, .62); --solid: #ffffff; --panel: rgba(255, 255, 255, .86); --card2: rgba(120, 110, 125, .09);
  --text: #23232a; --sub: #7d7a86; --line: rgba(60, 50, 70, .08); --on-sky: #ffffff; --on-sky-sub: rgba(255, 255, 255, .78);
  --chip-sky: rgba(90, 70, 85, .28); --off: #a9a6b0; --off-bg: rgba(110, 100, 120, .12);
  --danger: #e5484d; --ok: #2fa86b; --shadow: 0 2px 12px rgba(80, 60, 90, .08); --radius: 22px;
}
@media (prefers-color-scheme: dark) {
  :root {
    --sky: linear-gradient(175deg, #1c1f33 0%, #2a2540 35%, #3a2b3c 70%, #2a2128 100%);
    --glass: rgba(255, 255, 255, .07); --solid: rgba(255, 255, 255, .16); --panel: rgba(30, 30, 38, .78); --card2: rgba(255, 255, 255, .07);
    --text: #f0eef4; --sub: #a29fab; --line: rgba(255, 255, 255, .08); --chip-sky: rgba(255, 255, 255, .1);
    --off: #8a8794; --off-bg: rgba(255, 255, 255, .08); --shadow: none;
  }
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
/* overflow-x: clip, not hidden: "hidden" turns body / .page into scroll containers of their own, which
   swallowed the finger's vertical scroll in the Android WebView and broke the sticky tab bar. */
html, body { margin: 0; color: var(--text); }
body { font: 15px/1.45 "MiSans", -apple-system, "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", system-ui, sans-serif;
       -webkit-font-smoothing: antialiased; background: #cfa9b1; overflow-x: clip; }
/* The gradient sits on its own fixed layer: mobile WebViews ignore background-attachment: fixed. */
body::before { content: ""; position: fixed; inset: 0; background: var(--sky); z-index: -1; }
button { font: inherit; color: inherit; border: 0; background: none; cursor: pointer; padding: 0; }
.loading { padding: 40vh 0 0; text-align: center; color: var(--on-sky); }
.page { max-width: 640px; margin: 0 auto; padding: 0 14px calc(32px + var(--sab, env(safe-area-inset-bottom, 0px))); overflow-x: clip; }
/* Frosted strip behind the status bar, shown once the room tabs have stuck under it. */
.sbar { position: fixed; top: 0; left: 0; right: 0; height: var(--sat, env(safe-area-inset-top, 0px)); z-index: 6; pointer-events: none;
        transition: background .2s; }
body.stuck .sbar { background: rgba(150, 135, 165, .55); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }

/* ---- home header ---- */
.top { padding: calc(14px + var(--sat, env(safe-area-inset-top, 0px))) 6px 4px; color: var(--on-sky); }
.top-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.home-name { font-size: 23px; font-weight: 700; display: flex; align-items: center; gap: 2px; min-width: 0; letter-spacing: .5px; }
.home-name span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.home-name .caret { width: 20px; height: 20px; flex: none; opacity: .85; }
.home-name .caret svg { width: 20px; height: 20px; }
.weather { display: flex; align-items: center; gap: 6px; font-size: 19px; font-weight: 500; flex: none; }
.weather .wi { font-size: 22px; line-height: 1; }
.stats { display: flex; gap: 8px; margin: 18px 0 2px; }
.stat { flex: 1 1 0; min-width: 0; padding: 10px 4px; white-space: nowrap; border-radius: 16px; background: var(--chip-sky); color: var(--on-sky);
 text-align: center; font-size: 13px; }
.stat svg { width: 20px; height: 20px; display: block; margin: 0 auto 3px; }
.stat.warn { background: rgba(229, 72, 77, .85); }
.alert { margin: 12px 0 0; padding: 12px 14px; border-radius: 16px; background: rgba(229, 72, 77, .9); color: #fff;
         font-weight: 600; display: flex; gap: 8px; align-items: center; }
.alert svg { width: 20px; height: 20px; flex: none; }

.tabs { position: sticky; top: var(--sat, env(safe-area-inset-top, 0px)); z-index: 5; display: flex; gap: 22px; overflow-x: auto;
        scrollbar-width: none; padding: 4px 20px 6px; margin: 0 -14px 0; }
.tabs.stuck { background: rgba(150, 135, 165, .55); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
.tabs::-webkit-scrollbar { display: none; }
/* Active tab grows by transform (no reflow pushing its neighbours); the bar is one sliding element. */
.tab { flex: none; font-size: 16px; color: var(--on-sky-sub); position: relative; padding: 4px 0 10px; transform-origin: 50% 70%;
       transition: color .25s, transform .25s cubic-bezier(.2, .8, .25, 1); }
.tab.on { color: var(--on-sky); font-weight: 700; transform: scale(1.1); }
.tab-ind { position: absolute; left: 0; bottom: 8px; width: 22px; height: 3px; border-radius: 2px; background: var(--on-sky); pointer-events: none; }

.room-title { font-size: 13px; color: var(--on-sky); margin: 18px 6px 10px; font-weight: 600; opacity: .9; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
@media (min-width: 560px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

/* ---- device card ---- */
.card { position: relative; min-width: 0; background: var(--glass); border-radius: var(--radius); padding: 16px 16px 14px;

        min-height: 138px; display: flex; flex-direction: column; text-align: left; transition: transform .12s ease, background .25s; }
.card:active { transform: scale(.97); }
.card { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
/* long-press drag: the carried card floats above the grid, a dashed slot shows where it will land */
.card.lifted { transform: scale(1.06); background: var(--solid); box-shadow: 0 16px 40px rgba(60, 40, 70, .28); transition: none; opacity: .96; pointer-events: none; }
.card.ph { background: rgba(255, 255, 255, .18); border: 2px dashed rgba(255, 255, 255, .7); backdrop-filter: none; -webkit-backdrop-filter: none; }
.card.active { background: var(--solid); box-shadow: var(--shadow); }
/* offline: clearly out of the game - no colour, faded, flat */
.card.offline { opacity: .5; filter: grayscale(1); background: rgba(255, 255, 255, .28); }
.card.offline .name { color: var(--sub); }
.ico { width: 46px; height: 46px; border-radius: 15px; display: grid; place-items: center; color: var(--off); transition: background .2s, color .2s; }
.ico svg { width: 30px; height: 30px; }
.card.active .ico { background: color-mix(in srgb, var(--c) 14%, transparent); color: var(--c); }
/* one line like Mijia; long names get a smaller size before falling back to an ellipsis */
.card .name { margin-top: auto; padding-top: 12px; font-weight: 600; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.card .name.long { font-size: 13.5px; }
.card .st { color: var(--sub); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
.card.active .st { color: color-mix(in srgb, var(--c) 80%, var(--sub)); }
.card .st.warn { color: var(--danger); font-weight: 600; }
.pw { position: absolute; top: 14px; right: 14px; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center;
      background: var(--off-bg); color: var(--text); transition: background .2s, color .2s; }
.pw svg { width: 20px; height: 20px; }
.pw.on { background: var(--c); color: #fff; box-shadow: 0 4px 12px color-mix(in srgb, var(--c) 40%, transparent); }
.pws { position: absolute; top: 14px; right: 14px; display: flex; gap: 6px; }
.pws .pw { position: static; width: 34px; height: 34px; }
.pws .pw svg { width: 16px; height: 16px; }

/* ---- detail ---- */
.bar { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 4px; color: var(--on-sky);
       padding: calc(10px + var(--sat, env(safe-area-inset-top, 0px))) 6px 10px; margin: 0 -14px; }
.bar.stuck { background: rgba(150, 135, 165, .55); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
.back { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; }
.back svg { width: 26px; height: 26px; }
.bar .t { font-size: 19px; font-weight: 700; }
.bar .r { color: var(--on-sky-sub); font-size: 13px; }
.hero { padding: 18px 20px 26px; text-align: center; color: var(--on-sky); }
.hero .big-ico { width: 104px; height: 104px; margin: 0 auto; border-radius: 34px; display: grid; place-items: center;
                 background: var(--glass); color: var(--off);
                 transition: background .25s, color .25s; }
.hero .big-ico svg { width: 56px; height: 56px; }
.hero.active .big-ico { background: var(--solid); color: var(--c); box-shadow: var(--shadow); }
.hero .state { font-size: 26px; font-weight: 700; margin-top: 16px; }
.hero .state-sub { color: var(--on-sky-sub); font-size: 14px; margin-top: 2px; min-height: 20px; }
.big-pw { width: 68px; height: 68px; border-radius: 50%; margin: 18px auto 0; display: grid; place-items: center;
          background: var(--glass); color: var(--text); transition: all .2s; }
.big-pw svg { width: 30px; height: 30px; }
.big-pw.on { background: var(--c); color: #fff; box-shadow: 0 6px 20px color-mix(in srgb, var(--c) 50%, transparent); }
.keys { display: flex; gap: 10px; justify-content: center; margin-top: 18px; flex-wrap: wrap; }
.key { min-width: 86px; padding: 13px 14px; border-radius: 18px; background: var(--glass); color: var(--text); font-weight: 600;
 }
.key svg { width: 20px; height: 20px; display: block; margin: 0 auto 4px; }
.key.on { background: var(--c); color: #fff; }

.panel { background: var(--panel); border-radius: var(--radius); padding: 18px 16px; margin-top: 12px; box-shadow: var(--shadow);
 }
.panel.dim { opacity: .6; }
.panel h3 { margin: 0 0 6px; font-size: 14px; color: var(--sub); font-weight: 600; }
.temp { display: flex; align-items: center; justify-content: space-between; }
.temp .v { font-size: 52px; font-weight: 300; letter-spacing: -1px; }
.temp .v small { font-size: 18px; color: var(--sub); margin-left: 2px; }
.circle { width: 54px; height: 54px; border-radius: 50%; background: var(--card2); display: grid; place-items: center; font-size: 26px; color: var(--text); }
.circle:active { background: var(--line); }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip { padding: 9px 15px; border-radius: 14px; background: var(--card2); font-size: 14px; color: var(--text); }
.chip.on { background: var(--c); color: #fff; font-weight: 600; }
.sub-h { color: var(--sub); font-size: 13px; margin: 16px 0 8px; }
.sub-h:first-child { margin-top: 0; }
input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 40px; background: transparent; margin: 0; }
input[type=range]::-webkit-slider-runnable-track { height: 10px; border-radius: 5px;
  background: linear-gradient(to right, var(--c) var(--p, 50%), var(--card2) var(--p, 50%)); }
input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 28px; height: 28px; border-radius: 50%; margin-top: -9px;
  background: #fff; box-shadow: 0 1px 6px rgba(0, 0, 0, .25); }
.ct input[type=range]::-webkit-slider-runnable-track { background: linear-gradient(to right, #ffb35c, #fff1d6, #cfe3ff); }
.slider-h { display: flex; justify-content: space-between; color: var(--sub); font-size: 13px; }
.slider-h b { color: var(--text); font-weight: 600; }

.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); gap: 10px; }
.tile { background: var(--card2); border-radius: 16px; padding: 12px; min-width: 0; }
.tile .k { color: var(--sub); font-size: 12px; }
.tile .val { font-size: 20px; font-weight: 600; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 0; border-top: 1px solid var(--line); min-height: 54px; }
.row:first-of-type { border-top: 0; }
.row .l { flex: 1; min-width: 0; }
.row .rv { color: var(--sub); text-align: right; max-width: 55%; overflow-wrap: anywhere; }
.row .chips { justify-content: flex-end; }
.row.col { flex-direction: column; align-items: stretch; }
.row.col .chips { justify-content: flex-start; margin-top: 8px; }
.sw { width: 50px; height: 30px; border-radius: 15px; background: var(--off); position: relative; flex: none; transition: background .2s; }
.sw::after { content: ""; position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 50%; background: #fff;
             box-shadow: 0 1px 3px rgba(0, 0, 0, .2); transition: transform .2s; }
.sw.on { background: var(--c); }
.sw.on::after { transform: translateX(20px); }
.stepper { display: flex; align-items: center; gap: 10px; flex: none; }
.stepper button { width: 34px; height: 34px; border-radius: 50%; background: var(--card2); font-size: 18px; }
.stepper span { min-width: 54px; text-align: center; }
.act { padding: 8px 16px; border-radius: 12px; background: var(--card2); color: var(--c); font-weight: 600; }
select { font: inherit; color: var(--text); background: var(--card2); border: 0; border-radius: 12px; padding: 8px 10px; max-width: 55%; }
details.more { margin-top: 12px; }
details.more summary { list-style: none; color: var(--text); text-align: center; padding: 14px; font-size: 14px; border-radius: var(--radius);
                       background: var(--glass); }
details.more summary::-webkit-details-marker { display: none; }
.empty { color: var(--on-sky); text-align: center; padding: 40px 0; }
.foot { color: var(--sub); font-size: 12px; text-align: center; margin-top: 28px; }
.foot a { color: inherit; }

#toast { position: fixed; left: 50%; bottom: calc(28px + var(--sab, env(safe-area-inset-bottom, 0px))); transform: translateX(-50%) translateY(20px);
         background: rgba(30, 32, 36, .92); color: #fff; padding: 10px 16px; border-radius: 12px; font-size: 14px;
         opacity: 0; pointer-events: none; transition: all .25s; max-width: 86vw; z-index: 50; }
#toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* Room pager: every room is a page side by side; vertical scrolling stays native. */
/* No height animation: shrinking while the browser clamps the scroll made the page jump. At least one
   screen tall, so a short room can still be scrolled to sit right under the sticky tabs. */
.pager { overflow: clip; margin: 0 -14px; min-height: calc(100vh - 120px); }
.track { display: flex; align-items: flex-start; will-change: transform; }
.track > .roomview { flex: 0 0 100%; min-width: 0; padding: 0 14px; touch-action: pan-y; }

/* ---- edit mode (long press): Mijia-style selection, bars top and bottom ---- */
.selmark { display: none; position: absolute; top: 14px; right: 14px; width: 26px; height: 26px; border-radius: 50%;
           border: 2px solid rgba(120, 110, 130, .35); background: rgba(255, 255, 255, .5); place-items: center; color: #fff; }
.selmark svg { width: 16px; height: 16px; opacity: 0; }
body.editing .selmark { display: grid; }
body.editing .pw, body.editing .pws { display: none; }
body.editing .roomview .card { opacity: .78; }
body.editing .roomview .card.sel { opacity: 1; background: var(--solid); touch-action: none; }
.card.sel .selmark { background: #14a38b; border-color: #14a38b; }
.card.sel .selmark svg { opacity: 1; }
body.editing .tabs, body.editing .top { pointer-events: none; opacity: .5; }
#edit-top, #edit-bottom, #bnav { position: fixed; left: 0; right: 0; z-index: 60; backdrop-filter: blur(22px) saturate(1.3);
                                 -webkit-backdrop-filter: blur(22px) saturate(1.3); }
#edit-top { top: 0; padding: var(--sat, 0px) 8px 0; height: calc(var(--sat, 0px) + 56px); display: flex; align-items: center;
            justify-content: space-between; background: rgba(245, 242, 247, .86); color: var(--text); font-size: 17px; font-weight: 600; }
#edit-top button { min-width: 56px; height: 44px; display: grid; place-items: center; font-size: 15px; font-weight: 500; }
#edit-top .eb-ok svg { width: 26px; height: 26px; }
#edit-bottom { bottom: 0; padding: 8px 6px calc(var(--sab, 0px) + 8px); display: flex; background: rgba(245, 242, 247, .92); color: var(--text); }
#edit-bottom button, #bnav button { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 12px; padding: 4px 0; }
#edit-bottom svg { width: 24px; height: 24px; }
#edit-bottom button:disabled { opacity: .35; }
@media (prefers-color-scheme: dark) { #edit-top, #edit-bottom { background: rgba(32, 30, 40, .9); } }

/* ---- bottom navigation 家 / 智能: slim, no slab of colour, fades in from the page's own bottom tone ---- */
#bnav { bottom: 0; padding: 18px 56px calc(var(--sab, 0px) + 6px); display: flex; color: var(--sub); backdrop-filter: none; -webkit-backdrop-filter: none;
        background: linear-gradient(to top, rgba(241, 228, 221, .96) 55%, rgba(241, 228, 221, 0)); }
#bnav svg { width: 28px; height: 28px; }
#bnav button { gap: 3px; font-size: 13px; padding: 4px 0; }
#bnav button.on { color: var(--text); font-weight: 600; }
body.editing #bnav { display: none; }
.page { padding-bottom: calc(100px + var(--sab, 0px)); }
@media (prefers-color-scheme: dark) { #bnav { background: linear-gradient(to top, rgba(42, 33, 40, .96) 55%, rgba(42, 33, 40, 0)); } }

/* ---- bottom sheet ---- */
#sheet-mask { position: fixed; inset: 0; z-index: 200; background: rgba(20, 16, 24, .38); animation: fade .2s; }
#sheet { position: fixed; left: 8px; right: 8px; bottom: calc(var(--sab, 0px) + 8px); z-index: 201; background: var(--solid); color: var(--text);
         border-radius: 22px; padding: 20px 18px 16px; max-height: 70vh; overflow-y: auto; animation: up .22s ease-out; }
@media (prefers-color-scheme: dark) { #sheet { background: #26242c; } }
#sheet h3 { margin: 0 0 14px; font-size: 17px; text-align: center; }
.sheet-list { display: flex; flex-direction: column; }
.sheet-list > button { padding: 14px; font-size: 16px; border-top: 1px solid var(--line); }
.sheet-list > button:first-child { border-top: 0; }
.sheet-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 4px; border-top: 1px solid var(--line); }
.sheet-row small { display: block; color: var(--sub); font-size: 12px; }
.sheet-row button { color: #14a38b; font-weight: 600; padding: 6px 10px; flex: none; white-space: nowrap; }
#sheet input { width: 100%; font: inherit; font-size: 16px; padding: 12px 14px; border-radius: 12px; border: 0; background: var(--card2); color: var(--text); }
.sheet-btns { display: flex; gap: 10px; margin-top: 16px; }
.sheet-btns button { flex: 1; padding: 12px; border-radius: 14px; background: var(--card2); font-weight: 600; }
.sheet-btns .pri { background: #14a38b; color: #fff; }
.sheet-btns .pri.danger { background: var(--danger); }
.sheet-note { color: var(--sub); font-size: 13px; margin: 12px 4px 0; text-align: center; }
@keyframes up { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }

/* ---- 智能 page ---- */
.smart-sub { color: var(--on-sky-sub); font-size: 13px; margin-top: 4px; }
.autos { margin-top: 18px; display: flex; flex-direction: column; gap: 12px; }
.auto { display: flex; align-items: center; gap: 12px; background: var(--solid); border-radius: var(--radius); padding: 18px 16px; box-shadow: var(--shadow); }
.auto.off { background: var(--glass); }
.auto .l { flex: 1; min-width: 0; }
.auto .an { font-size: 16px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.auto .as { font-size: 12.5px; color: var(--sub); margin-top: 2px; }
.auto .act { --c: #14a38b; }
.offline-note { margin-top: 10px; padding: 7px 12px; border-radius: 12px; background: rgba(60, 50, 70, .28); color: #fff; font-size: 12.5px; display: inline-block; }

/* ---- + 添加设备 ---- */
.top-right { display: flex; align-items: center; gap: 12px; flex: none; }
.add-btn { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; color: var(--on-sky); background: var(--chip-sky); }
.add-btn svg { width: 20px; height: 20px; }
.add-sec { padding: 10px 2px; border-top: 1px solid var(--line); }
.add-sec:first-of-type { border-top: 0; }
.add-t { font-weight: 600; font-size: 15px; }
.add-sec .sheet-note { text-align: left; margin: 6px 0 0; }
.add-sec .sheet-btns { margin-top: 12px; }
.auto .ad { font-size: 13px; color: var(--text); opacity: .8; margin-top: 3px; }
.draft { display: inline-block; font-size: 11px; font-weight: 600; color: #b45309; background: rgba(245, 166, 35, .18); border-radius: 6px; padding: 1px 6px; margin-right: 6px; vertical-align: 2px; }
.smart-tip { margin-top: 12px; padding: 10px 12px; border-radius: 14px; background: rgba(60, 50, 70, .28); color: #fff; font-size: 12.5px; line-height: 1.5; }

/* ---- automation editor ---- */
.ed .panel h3 { margin-bottom: 8px; }
.ed-name { width: 100%; font: inherit; font-size: 17px; font-weight: 600; border: 0; background: transparent; color: var(--text); padding: 4px 2px; outline: none; }
.ed-row { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; text-align: left; padding: 12px 2px;
          border-top: 1px solid var(--line); font-size: 15px; }
.ed-row:first-of-type { border-top: 0; }
.ed-x svg { width: 18px; height: 18px; color: var(--sub); }
.ed-add { display: flex; align-items: center; gap: 6px; color: #14a38b; font-weight: 600; padding: 10px 2px 2px; }
.ed-add svg { width: 18px; height: 18px; }
.ed-btns { margin-top: 16px; }
.sheet-group { color: var(--sub); font-size: 12.5px; padding: 12px 4px 4px; }
.ed-win { display: flex; gap: 10px; }
.ed-win label { flex: 1; display: flex; align-items: center; gap: 6px; }
.ed-win input { flex: 1; }
.ed-days { justify-content: center; margin-top: 14px; }
#sheet input[type=time] { min-height: 44px; }

