/* product-style picture on a card: big, no tinted square; it greys out with the card when offline */
.card .art { width: 58px; height: 58px; margin: -2px 0 0 -4px; transition: transform .2s, filter .2s; }
.card .art svg { width: 100%; height: 100%; display: block; filter: drop-shadow(0 3px 5px rgba(40, 30, 50, .22)); }
.card.active .art svg { filter: drop-shadow(0 0 7px color-mix(in srgb, var(--c) 60%, transparent)) drop-shadow(0 3px 5px rgba(40, 30, 50, .22)); }
.card:not(.active) .art { opacity: .92; }

.hero .big-ico.art { width: 120px; height: 120px; background: none !important; box-shadow: none !important; }
.hero .big-ico.art svg { width: 100%; height: 100%; filter: drop-shadow(0 6px 10px rgba(30, 20, 50, .28)); }

.pi.art { width: 44px; height: 44px; } .pi.art svg { width: 100%; height: 100%; stroke: none; fill: none; filter: drop-shadow(0 2px 3px rgba(40, 30, 50, .2)); }
.mc.offline .pi.art, .mw.offline .pi.art { filter: grayscale(1); }

/* pull-to-refresh bar */
html, body { overscroll-behavior-y: contain; }
#ptr { position: fixed; top: calc(var(--sat, 0px) - 44px); left: 50%; margin-left: -60px; width: 120px; z-index: 120; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 8px 0; border-radius: 20px; background: var(--panel); box-shadow: var(--shadow); font-size: 13px; color: var(--text); opacity: 0; pointer-events: none; }
#ptr i { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--sub); border-top-color: transparent; }
#ptr.spin i { animation: ptrspin .7s linear infinite; } @keyframes ptrspin { to { transform: rotate(360deg); } }
/* a card with several switches: smaller picture and buttons so they do not overlap */
.card:has(.pws) .art { width: 42px; height: 42px; margin: 2px 0 0 0; }
.card .pws .pw { width: 30px; height: 30px; } .card .pws .pw svg { width: 15px; height: 15px; } .card .pws { gap: 5px; }
/* typing in a pop-up: sit in the upper part of the screen, above the keyboard */
#sheet.kb { top: calc(var(--sat, 0px) + 9vh); bottom: auto; max-height: 42vh; animation: none; }

/* the app reports the keyboard's height (--kb): the sheet rides on top of it and shrinks to what is left */
#sheet { bottom: calc(var(--sab, 0px) + 8px + var(--kb, 0px)); max-height: min(70vh, calc(100vh - var(--kb, 0px) - var(--sab, 0px) - var(--sat, 0px) - 24px)); transition: bottom .18s ease-out; }
#sheet.kb { transition: none; }

